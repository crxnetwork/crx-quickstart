# Copy to .env and fill in. The filled copy stays out of git.
# Two wallets: a hot signer that signs everything, a cold custody address it signs for.
# crx_maker.py reads both at import, so every script that imports it needs them.

CRX_SIGNER_PK=0x…                      # hot key. signs every quote, accept, and WS logon. was CRX_MAKER_PK
CRX_CUSTODY=0x…                        # cold custody address. the maker the signer acts for. an address, no key
# CRX_BASE=https://api.crxfx.com       # optional. defaults to https://api.crxfx.com
# CRX_RPC_URL=https://…                # the chain RPC for onchain sends. deposit.py, withdraw.py
# CRX_RECIPIENT=0x…                    # the withdrawal address, on the onchain route whitelist. withdraw.py
# CRX_TAKER_SIGNER_PK=0x…              # taker hot key. verify.py round trip, examples/take.py
# CRX_TAKER_CUSTODY=0x…                # taker cold custody address. verify.py round trip, examples/take.py
