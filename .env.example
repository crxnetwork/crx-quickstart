# Copy to .env and fill in. The filled copy stays out of git.
# crx_maker.py reads the key and the private key at import, so every script that imports it needs them.

CRX_API_KEY=crx_live_…                 # the minted maker key. every script
# CRX_BASE=https://api.crxfx.com       # optional. defaults to https://api.crxfx.com
CRX_MAKER_PK=0x…                       # the private key for the whitelisted EOA. every script
CRX_RPC_URL=https://…                  # the chain RPC for onchain sends. cancel.py, deposit.py, withdraw.py
CRX_CORE=0x…                           # the core address a cancel is sent to. cancel.py
CRX_RECIPIENT=0x…                      # the withdrawal address, on the onchain route whitelist. withdraw.py
# CRX_TAKER_KEY=crx_live_…             # a taker key, for the verify.py round trip only
# CRX_TAKER_PK=0x…                     # the private key for the taker EOA. verify.py only
